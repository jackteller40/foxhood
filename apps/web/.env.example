# Copy to .env.local and fill in. Never commit .env.local.
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials); redirect URI:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 33
AUTH_SECRET=
# Must match API_JWT_SECRET in apps/api/.env
API_JWT_SECRET=
API_URL=http://localhost:8000
